import java.util.*;
public class Main{
public static void main(String[]args){
Scanner s=new Scanner(System.in);
int n=s.nextInt();
int a[]=new int[n];
for(int i=0;i<n;i++){
a[i]=s.nextInt();
}
int min=a[0];
int max=0;
for(int -0;i<n;i++){
if(a[i]<min){
min=a[i];
}
int profit=a[i]-max;
if(profit>max){
max=profit;
}
}
System.out.println(max);
}
}
