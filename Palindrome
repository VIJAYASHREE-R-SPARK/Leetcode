import java.util.*;
public class Main{
public static void main(String[]args){
Scanner s=new Scanner(System.in);
int n=s.nextInt();
int temp=n;
if(n<0){
System.out.println("Not");
return;
}
int rev=0;
while(temp>0){
int d=temp%10;
rev=rev*10+d;
temp/=10;
}
System.out.println(rev==n?"Palindrome":"Not");
}
}

