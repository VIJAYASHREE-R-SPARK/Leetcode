import java.util.*;
public class Main{
public static void main(String[]args){
Scanner s=new Scanner(System.in);
int n=s.nextInt();
int temp=n;
int digits=0;
while(temp>0){
digits++;
temp/=10;
}
int sum=0;
temp=n;
while(temp>0){
int d=temp%10;
int pow=1;
for(int i=0;i<digits;i++){
pow*=d;
}
sum+=pow;
temp/=10;
}
System.out.println(sum==n?"Armstrong":"Not");
}
}
