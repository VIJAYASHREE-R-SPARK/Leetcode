class Solution {
    public String countAndSay(int n) {
        String cur = "1";
        for (int i = 2; i <= n; i++) {
            StringBuilder next = new StringBuilder();
            int count = 1;
            for (int j = 1; j <= cur.length(); j++) {
                if (j < cur.length() && cur.charAt(j) == cur.charAt(j - 1)) {
                    count++;
                } else {
                    next.append(count).append(cur.charAt(j - 1));
                    count = 1;
                }
            }
            cur = next.toString();
        }
        return cur;
    }
}
